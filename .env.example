# Copie para .env e ajuste. O .env real NUNCA vai pro git.

# Onde ficam o banco e (a partir da fase 3) as fotos criptografadas. No Orange Pi: o HDD.
REWIND_DATA_DIR=/mnt/hdd/rewind

# Fuso que define quando um "dia" começa e termina.
REWIND_TIMEZONE=America/Cuiaba

# true em produção (HTTPS). Só use false para testar em http://localhost.
REWIND_COOKIE_SECURE=true

# Por quantos dias um login continua válido.
REWIND_SESSION_DAYS=30

# Chave AES-256 das fotos. FORA da pasta de dados (e fora do git).
# Crie com: python -m app.cli generate-key   — e guarde uma cópia fora do servidor.
REWIND_KEY_FILE=/etc/rewind/rewind.key

# Limites de upload
REWIND_MAX_UPLOAD_MB=10
REWIND_EXTRAS_PER_DAY=10
